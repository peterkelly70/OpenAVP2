diff --git a/src/Band.c b/src/Band.c
index 9ccbabe..fc3cc9b 100644
--- a/src/Band.c
+++ b/src/Band.c
@@ -116,8 +116,12 @@ DmResult DmBand_download(DmBand* slf, DmLoader* loader) {
